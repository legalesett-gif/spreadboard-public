{
	admin off
}

spreadarbitrage.ink {
	encode zstd gzip

	reverse_proxy app:8200 {
		flush_interval -1
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
	}
}

www.spreadarbitrage.ink, spreadboard.178.128.126.204.sslip.io {
	redir https://spreadarbitrage.ink{uri} permanent
}

# These names are still registrar-parked. Keeping the redirect ready here means
# the owner only has to point the apex and www DNS records at this server;
# Caddy will obtain their certificates and preserve every incoming path.
spreadarbitrage.com, www.spreadarbitrage.com {
	redir https://spreadarbitrage.ink{uri} permanent
}

http://178.128.126.204 {
	redir https://spreadarbitrage.ink{uri} permanent
}
